	<!-- ═══════════════════════════════════════════════════════════════════════
	     TEKSTEN. Eén tour bedient de Nederlandse, Engelse en Franse site, dus
	     alle zichtbare tekst staat hier per taal. De taal komt mee in het adres
	     (?lang=nl|en|fr), meegegeven door de website; onbekend of ontbrekend
	     wordt Nederlands. Wil je een tekst wijzigen: pas hem hier aan, verder
	     niets. Geen aanhalingstekens of komma's om rekening mee te houden, het
	     staat tussen tags.
	     ═══════════════════════════════════════════════════════════════════ -->

	<data name="nl_scene_lobby">Lobby</data>
	<data name="en_scene_lobby">Lobby</data>
	<data name="fr_scene_lobby">Lobby</data>

	<data name="nl_scene_breakfast">Ontbijtzaal</data>
	<data name="en_scene_breakfast">Breakfast room</data>
	<data name="fr_scene_breakfast">Salle du petit-déjeuner</data>

	<data name="nl_bf_title">Elke ochtend vers</data>
	<data name="nl_bf_body">Geen kant-en-klaar buffet. Eieren van vrije-uitloopkippen, fair-trade koffie, confituur van Callas uit Gent, kaas en melk van boeren uit de streek. Van maandag tot vrijdag van 7 tot 10 uur, in het weekend van 8 tot 11.</data>
	<data name="en_bf_title">Fresh every morning</data>
	<data name="en_bf_body">No ready-made buffet. Free-range eggs, fair-trade coffee, Callas jam from Ghent, cheese and milk from farmers nearby. Monday to Friday from 7 to 10, weekends from 8 to 11.</data>
	<data name="fr_bf_title">Frais chaque matin</data>
	<data name="fr_bf_body">Pas de buffet tout fait. Œufs de poules élevées en plein air, café équitable, confiture Callas de Gand, fromage et lait de fermiers des environs. Du lundi au vendredi de 7 à 10 heures, le week-end de 8 à 11 heures.</data>

	<data name="nl_lobby_title">Aan de receptie</data>
	<data name="nl_lobby_body">Hier krijg je je sleutel, een stadsplan en de Gentse Citycard. En tips van mensen die Gent echt kennen: waar je goed eet, wat je gerust mag overslaan. Het Sint-Pietersstation ligt op twee minuten wandelen.</data>
	<data name="en_lobby_title">At reception</data>
	<data name="en_lobby_body">Where you get your key, a city map and the Ghent Citycard. Plus tips from people who actually know the city: where to eat well, what you can skip. Sint-Pieters station is a two minute walk.</data>
	<data name="fr_lobby_title">A la réception</data>
	<data name="fr_lobby_body">Ici vous recevez votre clé, un plan de la ville et la Citycard gantoise. Et les conseils de gens qui connaissent vraiment Gand : où bien manger, ce que vous pouvez laisser de côté. La gare Saint-Pierre est à deux minutes à pied.</data>

	<data name="nl_scene_DeluxeBedroom_Panorama">Deluxe Double</data>
	<data name="en_scene_DeluxeBedroom_Panorama">Deluxe Double</data>
	<data name="fr_scene_DeluxeBedroom_Panorama">Deluxe Double</data>

	<data name="nl_scene_DeluxeBathroom_Panorama">Deluxe Double · badkamer</data>
	<data name="en_scene_DeluxeBathroom_Panorama">Deluxe Double · bathroom</data>
	<data name="fr_scene_DeluxeBathroom_Panorama">Deluxe Double · salle de bain</data>

	<data name="nl_scene_1-TwinBedroom">Comfort Twin</data>
	<data name="en_scene_1-TwinBedroom">Comfort Twin</data>
	<data name="fr_scene_1-TwinBedroom">Comfort Twin</data>

	<data name="nl_scene_2-TwinBathroom">Comfort Twin · badkamer</data>
	<data name="en_scene_2-TwinBathroom">Comfort Twin · bathroom</data>
	<data name="fr_scene_2-TwinBathroom">Comfort Twin · salle de bain</data>

	<data name="nl_dlx_title">Onze grootste kamer</data>
	<data name="nl_dlx_body">35 m² onder het dak, met een bed van twee meter breed. Afhankelijk van de kamer hoort er een ligbad of een eigen terras bij.</data>
	<data name="en_dlx_title">Our largest room</data>
	<data name="en_dlx_body">35 m² under the eaves, with a bed two metres wide. Depending on the room it comes with a bathtub or a terrace of your own.</data>
	<data name="fr_dlx_title">Notre plus grande chambre</data>
	<data name="fr_dlx_body">35 m² sous les combles, avec un lit de deux mètres de large. Selon la chambre, une baignoire ou une terrasse privée.</data>

	<data name="nl_twn_title">Twee aparte bedden</data>
	<data name="nl_twn_body">Twee bedden van 90 cm, elk met een eigen leeslamp. Een douche of een ligbad, afhankelijk van de kamer.</data>
	<data name="en_twn_title">Two separate beds</data>
	<data name="en_twn_body">Two 90 cm beds, each with its own reading light. A shower or a bathtub, depending on the room.</data>
	<data name="fr_twn_title">Deux lits séparés</data>
	<data name="fr_twn_body">Deux lits de 90 cm, chacun avec sa liseuse. Une douche ou une baignoire, selon la chambre.</data>

	<!-- Kiest de taal en zet de namen van de ruimtes. Draait voor het panorama
	     laadt, zodat de tooltip bij het zweven meteen klopt. -->
	<action name="chamade_texts" autorun="preinit">
		set(lg, get(lang));
		if(lg != 'en' AND lg != 'fr', set(lg, 'nl'));
		txtadd(k, get(lg), '_scene_lobby');     copy(scene[scene_lobby].title,     data[get(k)].content);
		txtadd(k, get(lg), '_scene_breakfast'); copy(scene[scene_breakfast].title, data[get(k)].content);
		txtadd(k, get(lg), '_scene_DeluxeBedroom_Panorama'); copy(scene[scene_DeluxeBedroom_Panorama].title, data[get(k)].content);
		txtadd(k, get(lg), '_scene_DeluxeBathroom_Panorama'); copy(scene[scene_DeluxeBathroom_Panorama].title, data[get(k)].content);
		txtadd(k, get(lg), '_scene_1-TwinBedroom'); copy(scene[scene_1-TwinBedroom].title, data[get(k)].content);
		txtadd(k, get(lg), '_scene_2-TwinBathroom'); copy(scene[scene_2-TwinBathroom].title, data[get(k)].content);
	</action>

